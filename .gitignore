# =========================================================
# QT 뷰어 워크스페이스 .gitignore
# 원칙: APK/웹 빌드에 필요한 소스만 git에 올리고,
#       빌드 산출물과 환경 의존 파일은 git에 싱크하지 않는다.
# =========================================================

# ---------- 빌드 산출물 (git 불필요) ----------
*.apk
*.aab
*.ap_
*.zip
/build/
/build-*/
qt_viewer/build/

# ---------- IDE / 에디터 설정 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---------- OS 생성 파일 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 로그 / 임시 파일 ----------
*.log
*.tmp
*.bak
*.swp

# ---------- 서명 키 / 민감 정보 ----------
key.properties
*.jks
*.keystore
google-services.json

# ---------- 기타 ----------
.widget_preview/
